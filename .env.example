# 司法 AI 中台 —— 本地联调环境变量样例
# 复制为 .env（.env 已被 gitignore，不会提交），配合 deploy/docker-compose.backends.yml 使用：
#   docker compose -f deploy/docker-compose.backends.yml up -d
#   uv run uvicorn judicial_ai.app:create_app --factory --port 8000

# ---------- 基础 ----------
APP_ENV=dev
# 示例合同审查仅限非生产环境，设为 false 可在开发环境关闭。
# CONTRACT_REVIEW_ENABLED=false
ADMIN_TOKEN=change-me-local-admin
ALLOW_STATIC_ADMIN=true
OBJECT_STORE_BACKEND=filesystem
OBJECT_STORE_PATH=./data/objects
DOCUMENT_RETENTION_DAYS=30
INDEX_REQUIRE_APPROVAL=false
REQUIRE_PROD_ALIAS=false

# ---------- 真实后端地址（docker compose 启动后生效）----------
MILVUS_URI=http://localhost:19530
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=jai-neo4j-dev
REDIS_URL=redis://localhost:6379/0

# 切换真实后端（默认 sql/sql 是 SQLite+内存兜底；联调时按需打开）
# VECTOR_BACKEND=milvus
# GRAPH_BACKEND=neo4j

# ---------- 模型推理（vLLM，OpenAI 兼容协议）----------
# INFERENCE_MODE=proxy
# INFERENCE_BASE_URL=http://<vllm-host>:8000/v1
# INFERENCE_API_KEY=<vllm-key，无鉴权可留空>

# ---------- JEV 决策服务（可选，影子/灰度）----------
# DECISION_SHADOW_ENABLED=true
# DECISION_JEV_CANARY_PERCENT=25
# JEV_BASE_URL=http://<jev-host>:9000
# JEV_API_KEY=<jev-key>

# ---------- 细粒度 ACL ----------
RESOURCE_ACL_ENFORCED=false

# 本地「契约验收」环境（无需 Docker / 无需任何外部中间件）
#
# 用途：在单机上验证 A01/A03/A05/A08 的**接口契约与判定逻辑**。
# 明确边界：
#   - 不是生产等价环境，结论不能用于上线签字；
#   - 向量检索走 SQL 全表余弦，性能与 Milvus 无关；
#   - 推理为 mock，回答是模板文本（A05 的语义正确性不可判定）；
#   - 因此本文件只用于"功能是否按契约工作"，不用于容量与故障恢复结论。
#
# 用法：
#   python scripts/check_env.py --env-file .env.local-staging   # 会显示与生产口径的差异
#   python scripts/acceptance/run_staging_acceptance.py --asgi --admin-token <ADMIN_TOKEN> --scenario all
#   python scripts/acceptance/fault_injection_local.py

APP_ENV=local-staging
APP_VERSION=0.2.0
DATA_DIR=./data

# 单机 SQLite，随进程自动建表
DATABASE_URL=sqlite:///./data/local-staging.db
AUTO_CREATE_SCHEMA=true
ALLOW_STATIC_ADMIN=true
ADMIN_TOKEN=local-staging-admin-token-please-change-0001
# 本地固定值，仅用于让凭证摘要可复现；生产必须来自密钥管理系统
API_KEY_HASH_SECRET=local-staging-hash-secret-please-change-01

# 无 Redis：限流与缓存自动退回进程内存（/readyz 显示 disabled，不算故障）
REDIS_URL=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=true

# Windows 无法运行 Milvus（含 milvus-lite），因此这里只能是 SQL 后端。
# 想验证真实向量检索，必须连一台 Linux 上的 Milvus（改 MILVUS_URI 即可）。
VECTOR_BACKEND=sql
VECTOR_FALLBACK_SQL=true

# 图谱默认关闭；本机可用 Neo4j Community zip（需 JDK 21）打开。
GRAPH_ENABLED=false
GRAPH_BACKEND=sql
GRAPH_FAIL_OPEN=true

# mock 推理；装了 Ollama 后改为：
#   INFERENCE_MODE=proxy
#   INFERENCE_BASE_URL=http://127.0.0.1:11434/v1
INFERENCE_MODE=mock
EMBEDDING_MODEL=deterministic
EMBEDDING_DIM=1024

AUTH_MODE=token
TOKEN_REVOCATION_ENABLED=true
TOKEN_REVOCATION_CACHE_SECONDS=0

# 把生产语义的开关也打开，用单机环境验证治理流程本身
RESOURCE_ACL_ENFORCED=true
INDEX_REQUIRE_APPROVAL=true
REQUIRE_PROD_ALIAS=true
KB_AUTO_INDEX_AFTER_UPLOAD=true
CONTRACT_REVIEW_ENABLED=false

CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
TRUSTED_HOSTS=127.0.0.1,localhost
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=false
MAX_REQUEST_BYTES=10485760

OBJECT_STORE_BACKEND=filesystem
OBJECT_STORE_PATH=./data/objects
DOCUMENT_RETENTION_DAYS=30

JOB_MODE=inline
WORKER_POLL_SECONDS=2

DEFAULT_TOP_K=10
MAX_TOP_K=50
# 单机 embedding 与真实模型分布不同，阈值只能用来验证"过滤是否生效"，
# 真实取值必须用评测集标定。
RAG_MIN_DENSE_SCORE=0.15
RAG_MIN_KEYWORD_SCORE=0.3
RAG_COMPRESSION_ENABLED=true
RAG_COMPRESSION_PROVIDER=extractive
RAG_COMPRESSION_MAX_CHARS=8000

DECISION_PROVIDER=rule
DECISION_SHADOW_ENABLED=false
DECISION_JEV_CANARY_PERCENT=0

METRICS_ENABLED=true
ACCESS_LOG_ENABLED=true
LOG_LEVEL=INFO

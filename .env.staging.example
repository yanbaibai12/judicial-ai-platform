# 司法 AI 中台 —— staging（生产等价联调）环境变量样例
#
# 用法：
#   Copy-Item .env.staging.example .env.staging
#   填写 <尖括号> 中的真实地址与凭据
#   python scripts/check_env.py --env-file .env.staging     # 先做预检
#
# 说明：
# - APP_ENV 使用 staging 而不是 prod，是为了保留 ALLOW_STATIC_ADMIN 以便自动化验收脚本
#   可以直接用管理员令牌驱动；**其余生产闸门全部按生产要求打开**，见下方"生产等价开关"。
#   验收完成后应把 ALLOW_STATIC_ADMIN 改为 false，并改用 OIDC 管理员身份。
# - 任何一项被注释掉的配置，都会回落到代码默认值（多为本地 SQLite/mock），
#   等于悄悄降级，`scripts/check_env.py` 会把这些不一致报出来。

# ---------- 基础 ----------
APP_ENV=staging
APP_VERSION=0.2.0
# staging 例外：仅用于自动化验收，验收结束改 false
ALLOW_STATIC_ADMIN=true
ADMIN_TOKEN=<32位以上随机令牌>
DOCS_ENABLED=true
DATA_DIR=./data

# ---------- 数据库（必须 MySQL/MariaDB）----------
DATABASE_URL=mysql+pymysql://jai:<password>@<mysql-host>:3306/judicial_ai?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
AUTO_CREATE_SCHEMA=false

# ---------- 凭证摘要密钥（生产必填，≥32 字符）----------
API_KEY_HASH_SECRET=<32位以上随机密钥，来自密钥管理系统>
# 轮换期才填，多个用逗号分隔；与主密钥不得重复
# API_KEY_HASH_LEGACY_SECRETS=

# ---------- 缓存与限流 ----------
REDIS_URL=redis://:<password>@<redis-host>:6379/0
REDIS_KEY_PREFIX=jai-staging
RATE_LIMIT_ENABLED=true
# 生产等价：Redis 故障时不放行，由 /readyz 暴露为 critical
RATE_LIMIT_FAIL_OPEN=false

# ---------- 向量检索（Milvus）----------
VECTOR_BACKEND=milvus
MILVUS_URI=http://<milvus-host>:19530
# MILVUS_TOKEN=<milvus-token，无鉴权留空>
MILVUS_COLLECTION_PREFIX=jai_staging_chunks
MILVUS_SPARSE_ENABLED=true
# 生产等价：向量库故障时不得静默退回 SQL 全表扫描
VECTOR_FALLBACK_SQL=false

# ---------- 图谱检索（Neo4j）----------
GRAPH_ENABLED=true
GRAPH_BACKEND=neo4j
NEO4J_URI=bolt://<neo4j-host>:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<neo4j-password>
NEO4J_DATABASE=neo4j
GRAPH_MAX_DEPTH=2
# 生产等价：图谱故障必须可见，不得静默降级
GRAPH_FAIL_OPEN=false

# ---------- 模型推理（vLLM，OpenAI 兼容）----------
INFERENCE_MODE=proxy
INFERENCE_BASE_URL=http://<vllm-host>:8000/v1
INFERENCE_API_KEY=<vllm-key，无鉴权留空>
INFERENCE_TIMEOUT_SECONDS=60
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ---------- 身份（OIDC / LDAP）----------
# 只做 A01/A03/A05 时可用 token；要跑 A07 撤销生效时间必须切换为 hybrid 并接真实 IdP
AUTH_MODE=hybrid
OIDC_ISSUER=https://<idp-host>/realms/judicial
OIDC_AUDIENCE=judicial-ai-platform
OIDC_JWKS_URL=https://<idp-host>/realms/judicial/protocol/openid-connect/certs
OIDC_ALGORITHMS=RS256
OIDC_ADMIN_ROLES=platform-admin
OIDC_OPERATOR_ROLES=platform-operator
OIDC_READER_ROLES=platform-reader
TOKEN_REVOCATION_ENABLED=true
# 撤销生效时间上限；验收 A07 时建议设 0（每次请求查库）或 5
TOKEN_REVOCATION_CACHE_SECONDS=5
# LDAP 按需填写
# LDAP_SERVER=ldaps://<ldap-host>:636
# LDAP_USER_SEARCH_BASE=ou=people,dc=example,dc=com

# ---------- 生产等价开关（缺一即视为降级）----------
RESOURCE_ACL_ENFORCED=true
INDEX_REQUIRE_APPROVAL=true
REQUIRE_PROD_ALIAS=true
KB_AUTO_INDEX_AFTER_UPLOAD=true
# 示例合同审查规则未经法律审核，staging 先关闭，避免误用
CONTRACT_REVIEW_ENABLED=false

# ---------- 安全边界 ----------
CORS_ORIGINS=https://<console-host>
TRUSTED_HOSTS=<api-host>,127.0.0.1,localhost
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=true
MAX_REQUEST_BYTES=10485760

# ---------- 对象存储与保留 ----------
OBJECT_STORE_BACKEND=filesystem
OBJECT_STORE_PATH=/data/objects
DOCUMENT_RETENTION_DAYS=30

# ---------- 异步任务（必须独立 Worker）----------
JOB_MODE=worker
WORKER_POLL_SECONDS=2
WORKER_BATCH_SIZE=10
WORKER_HEARTBEAT_SECONDS=30
WORKER_STALE_SECONDS=900
JOB_MAX_ATTEMPTS=3

# ---------- 检索与压缩 ----------
DEFAULT_TOP_K=10
MAX_TOP_K=50
# 相关性下限：两个信号都低于阈值时丢弃候选，避免无关查询照样返回 top_k。
# 0 表示关闭。以下数值是起点，接入真实 embedding/rerank 后必须用评测集重新标定：
# 阈值过高会把相关短查询一起过滤（实测 0.5 时 "ALPHA-xxx" 也被丢弃）。
RAG_MIN_DENSE_SCORE=0.15
RAG_MIN_KEYWORD_SCORE=0.3
RAG_COMPRESSION_ENABLED=true
RAG_COMPRESSION_PROVIDER=extractive
RAG_COMPRESSION_MAX_CHARS=8000
RAG_COMPRESSION_SEGMENT_AWARE=true
RAG_RERANK_MODEL=bge-reranker-v2-m3

# ---------- 决策引擎（JEV 仅影子，不得切主链路）----------
DECISION_PROVIDER=rule
DECISION_SHADOW_ENABLED=true
DECISION_JEV_CANARY_PERCENT=0
# JEV_BASE_URL=http://<jev-host>:9000
# JEV_API_KEY=<jev-key>

# ---------- 可观测 ----------
METRICS_ENABLED=true
ACCESS_LOG_ENABLED=true
LOG_LEVEL=INFO
